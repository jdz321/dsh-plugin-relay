{
  "name": "dsh-plugin-relay",
  "version": "0.7.0",
  "description": "DeepSeek Harness (dsh) plugin that routes model traffic through new-api-family relay panels (one-api / new-api / Veloera / done-hub / ...) — several panels at once, each its own model provider: manage panels (accordion with inline keys / models / dashboard / logs tabs), create / edit / delete and switch API keys, sync each key's model list with pricing, review usage dashboard (dual-axis) and logs, and configure model capabilities from a mainstream-model knowledge base — all from the dsh Plugins settings page",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdz321/dsh-plugin-relay.git"
  },
  "bugs": {
    "url": "https://github.com/jdz321/dsh-plugin-relay/issues"
  },
  "homepage": "https://github.com/jdz321/dsh-plugin-relay#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/dev.js",
    "preset:fetch": "node --import ./scripts/ts-resolver.mjs scripts/fetch-knowledge-preset.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-alpha.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "new-api",
    "one-api",
    "veloera",
    "done-hub",
    "relay",
    "中转站"
  ]
}
